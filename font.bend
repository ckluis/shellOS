# Index walk (same shape as list_get in term.bend).
def font_nth(+xs: List<&2, U32>, +idx: U32) -> U32:
  match xs, idx:
    case Nil{}, _: 0
    case h <> _, 0: h
    case _ <> t, i: font_nth(t, U32.sub(i, 1))

def font_byte(+tbl: List<&2, U32>, +idx: U32) -> U32:
  font_nth(tbl, idx)
