def font_q(hi: U32, lo: U32) -> U32:
  match hi:
    case 0: fq0(lo)
    case 1: fq1(lo)
    case 2: fq2(lo)
    case _: fq3(lo)

def font_byte(+idx: U32) -> U32:
  font_q(U32.shrn(idx, 8n), U32.and(idx, 255))
