    case 0: fb2_0(mid, lo)
    case 1: fb2_1(mid, lo)
    case 2: fb2_2(mid, lo)
    case 3: fb2_3(mid, lo)
    case _: fb2_0(mid, lo)

def font_byte(+idx: U32) -> U32:
  fb2(U32.shrn(idx, 8n), U32.and(U32.shrn(idx, 4n), 15), U32.and(idx, 15))
